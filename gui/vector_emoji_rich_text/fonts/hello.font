font: "/fonts/Inter-ExtraBold.otf"
material: "/builtins/fonts/font-vector.material"
characters: " !\"#$%&\'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
styles {
  name: "default"
}
styles {
  name: "link"
  markup: "<color=#1972e5><ul>"
}
styles {
  name: "link:hover"
  markup: "<color=#4ca5ff>"
}
styles {
  name: "link:active"
  markup: "<color=#0c4cb2>"
}
vector_font_mode: VECTOR_FONT_MODE_VECTOR
runtime: true

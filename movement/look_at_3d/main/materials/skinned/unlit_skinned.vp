#version 140

in highp vec4 position;
in mediump vec2 texcoord0;
in mediump vec4 bone_weights;
in mediump vec4 bone_indices;

out mediump vec2 var_texcoord0;

uniform vs_uniforms
{
	mediump mat4 mtx_worldview;
	mediump mat4 mtx_proj;
	mediump vec4 animation_data;
};

#include "/builtins/materials/skinning.glsl"

void main()
{
	vec4 skinned_position = get_skinned_position(position);

	var_texcoord0 = texcoord0;

	vec4 p = mtx_worldview * vec4(skinned_position.xyz, 1.0);
	gl_Position = mtx_proj * p;
}